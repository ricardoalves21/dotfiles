/**
 * Tema do Menu de Atalhos do Hyprland para o Rofi (Catppuccin Mocha)
 */

@theme "/dev/null"

* {
    bg-col:       #1e1e2ef2;
    bg-col-light: #313244;
    border-col:   #89b4fa;
    selected-col: #45475a;
    blue:         #89b4fa;
    fg-col:       #cdd6f4;
    fg-sub:       #a6adc8;
    grey:         #6c7086;
    font:         "JetBrainsMono Nerd Font 11";

    background-color: transparent;
    text-color:       @fg-col;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            900px;
    background-color: @bg-col;
    border:           2px;
    border-color:     @border-col;
    border-radius:    14px;
    padding:          18px;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
    spacing:          10px;
}

inputbar {
    background-color: @bg-col-light;
    border-radius:    10px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          10px;
}

prompt {
    background-color: transparent;
    text-color:       @blue;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    background-color:  transparent;
    text-color:        @fg-col;
    placeholder:       "Pesquisar por tecla, categoria ou ação...";
    placeholder-color: @grey;
}

message {
    background-color: transparent;
    padding:          0px 4px 2px 4px;
}

textbox {
    background-color: transparent;
    text-color:       @fg-sub;
    font:             "JetBrainsMono Nerd Font 10";
}

listview {
    background-color: transparent;
    lines:            14;
    columns:          1;
    spacing:          4px;
    cycle:            true;
    dynamic:          true;
    scrollbar:        true;
    fixed-height:     false;
}

scrollbar {
    width:            4px;
    border:           0;
    handle-color:     @blue;
    handle-width:     4px;
    background-color: @bg-col-light;
    border-radius:    4px;
    margin:           0px 0px 0px 8px;
}

element {
    background-color: transparent;
    text-color:       @fg-col;
    border-radius:    8px;
    padding:          7px 12px;
}

element selected.normal {
    background-color: @selected-col;
    text-color:       @fg-col;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    markup:           true;
}
